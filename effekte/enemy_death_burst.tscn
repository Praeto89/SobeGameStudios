[gd_scene load_steps=2 format=3 uid="uid://enemyburst0001"]

; Partikel-Burst beim Gegnertod. Drag&Drop als Kind eines Slimes.
; WICHTIG: Den Node "TodExplosion" nennen (wird von slime_base.gd erwartet).
;
; Ausloesung erfolgt automatisch durch slime_base.gd beim Tod des Gegners.
; Der Node loest sich beim Ausloesen vom Elternknoten und bereinigt sich selbst.
;
; Tunen:
;   TodExplosion anklicken -> amount, color, scale_amount, lifetime, ...

[ext_resource type="Script" path="res://effekte/enemy_death_burst.gd" id="1_burst"]

[node name="TodExplosion" type="CPUParticles2D"]
script = ExtResource("1_burst")
emitting = false
amount = 20
lifetime = 0.5
one_shot = true
explosiveness = 0.95
randomness = 0.6
direction = Vector2(0, -1)
spread = 180.0
gravity = Vector2(0, 400)
initial_velocity_min = 40.0
initial_velocity_max = 120.0
scale_amount_min = 0.04
scale_amount_max = 0.09
color = Color(0.4, 0.9, 0.3, 0.9)
